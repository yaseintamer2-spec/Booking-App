# Public API server origin. For production, set this to the hosted API server's
# HTTPS URL; the Supabase project URL is not this API URL.
# Local web defaults to http://localhost:5000 if omitted.
EXPO_PUBLIC_API_URL=http://localhost:5000

# Public key from the same Clerk development application as the API.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_key
