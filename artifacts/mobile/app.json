{
  "expo": {
    "name": "KORZA | كورزا",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/korza-logo.png",
    "scheme": "kickoff",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/korza-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A100E"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/korza-logo.png",
        "backgroundColor": "#0A100E"
      }
    },
    "web": {
      "favicon": "./assets/images/korza-logo.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KORZA | كورزا admins to choose match photos and players to choose a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow KORZA | كورزا to use your location while you are using the app."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow KORZA | كورزا to scan match check-in codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
