# Local PostgreSQL connection
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/kickoff

# Clerk development application (server-side)
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_key
CLERK_SECRET_KEY=sk_test_replace_with_your_key

# Admin access is managed by the owner in Profile → Admin console.
# The permanent owner account is yaseintamer2@gmail.com.
# Comma-separated verified referee/staff emails (admins are included automatically)
MATCH_STAFF_EMAILS=

# API server
PORT=5000

# Cloudflare R2 (S3-compatible) pitch photo storage
# Create a bucket, an API token with object read/write access, and attach a public custom domain.
OBJECT_STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
OBJECT_STORAGE_BUCKET=kickoff-pitch-photos
OBJECT_STORAGE_ACCESS_KEY_ID=replace_with_r2_access_key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace_with_r2_secret_key
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_PUBLIC_BASE_URL=https://images.example.com
